{
  "required": true,
  "package": "com.mesoulcard.mixins",
  "compatibilityLevel": "JAVA_21",
  "plugin": "com.mesoulcard.MixinPlugin",
  "mixins": [
    "patternprovider.UpgradeablePatternProviderScreenMixin",
    "patternprovider.UpgradeablePatternProviderMenuMixin",
    "patternprovider.UpgradeablePatternProviderLogicMixin",
    "PatternProviderLogicHostMixin",
    "PatternProviderLogicMixin",
    "PatternProviderPartMixin",
    "PartExPatternProviderMixin",
    "PatternProviderScreenMixin",
